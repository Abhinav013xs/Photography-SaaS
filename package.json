{
  "name": "photography-saas",
  "version": "1.0.0",
  "description": "Production Photography Gallery Management & AI Biometric Face Search Platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=@photography-saas/api run dev",
    "dev:web": "npm --workspace=@photography-saas/web run dev",
    "build": "npm --workspaces --if-present run build",
    "typecheck": "npm --workspaces run typecheck",
    "test": "vitest run",
    "test:perf": "tsx tests/performance/run_all_benchmarks.ts",
    "test:load": "tsx scripts/load-test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:migrate:down": "tsx scripts/migrate.ts down",
    "db:migrate:status": "tsx scripts/migrate.ts status",
    "db:migrate:reset": "tsx scripts/migrate.ts reset",
    "db:seed": "tsx scripts/seed.ts",
    "setup:owner": "tsx scripts/setup-owner.ts",
    "env:validate": "tsx scripts/validate-env.ts",
    "health": "tsx scripts/check-health.ts",
    "bin:purge": "tsx scripts/purge-expired-bin.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts",
    "storage:audit": "tsx scripts/verify-storage-consistency.ts",
    "smoke:check": "tsx scripts/production-smoke-check.ts",
    "build:client": "npm --prefix client run build",
    "build:all": "npm run build && npm --prefix client run build",
    "dev": "concurrently -k -n \"api,client\" -c \"yellow.bold,cyan.bold\" \"node server/index.js\" \"npm --prefix client run dev\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "set-credentials": "node scripts/set-credentials.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "jsqr": "^1.4.0",
    "oxlint": "^1.81.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
