# ===================================================================
# STUDIO LUMINA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and populate with your environment secrets.
# NEVER commit production credentials to version control.
# ===================================================================

# Application Environment
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# Authentication & Session Security (Minimum 32 characters in production)
AUTH_SECRET=replace_with_cryptographically_secure_random_string_min_32_chars

# PostgreSQL 16+ Database with pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/photography_saas
DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Redis Message Broker & Rate Limiting
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=studio_lumina:

# Python AI Biometric Microservice
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=10000

# Cloudflare R2 Object Storage (Photographer's Direct Account)
# Zero egress fees. Credentials provided by Cloudflare R2 API Tokens.
# Never expose these credentials to browser clients.
R2_ACCOUNT_ID=your_32_character_cloudflare_account_id
R2_ACCESS_KEY_ID=your_32_character_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_64_character_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
# Optional: Explicit custom S3 endpoint override (used for local S3 mocks, MinIO, or custom domains)
# Default constructed: https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional: Custom domain connected to R2 bucket for public asset delivery (if configured)
R2_PUBLIC_DOMAIN=

# Video Processing & Transcoding Pipeline (Phase 12)
# Binary paths (default to system PATH 'ffmpeg' and 'ffprobe')
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Video processing limits
VIDEO_MAX_SIZE_BYTES=524288000
VIDEO_CONCURRENCY=1
VIDEO_TIMEOUT_MS=120000
VIDEO_POSTER_TIMESTAMP_SECONDS=1.0
VIDEO_PLAYBACK_MAX_WIDTH=1920
VIDEO_PLAYBACK_MAX_HEIGHT=1080

